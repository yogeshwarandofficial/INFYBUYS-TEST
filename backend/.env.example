# =============================================================================
# INFYBUYS — Backend Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# Variables marked [REQUIRED] will cause the app to crash at startup if missing.
# Variables marked [OPTIONAL] have safe defaults for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Database [REQUIRED]
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# -----------------------------------------------------------------------------
# JWT Authentication [REQUIRED]
# Use a long, random secret (e.g. openssl rand -hex 64)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_here
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# -----------------------------------------------------------------------------
# Admin Seed User [REQUIRED for `npm run seed`]
# These are only used during the initial database seed.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_here

# -----------------------------------------------------------------------------
# Frontend URL — used for CORS [REQUIRED in production]
# Set to the production domain in prod. Supports comma-separated list.
# e.g. FRONTEND_URL=https://app.infybuys.com
# Defaults to http://localhost:5173 if not set (safe for local dev).
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# AWS S3 — Media storage [REQUIRED for file uploads]
# The S3 bucket must be fully private (no public-read ACL or bucket policy).
# All object access is via presigned URLs generated by the backend.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name

# -----------------------------------------------------------------------------
# Resend — Transactional Email (OTP verification) [REQUIRED for email features]
# Get your API key at https://resend.com
# EMAIL_FROM must be a verified sender domain in your Resend account.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="INFYBUYS <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Email Verification Feature Flag [OPTIONAL]
# The backend is the source of truth for this flag.
# Set to "true" to enforce OTP email verification on login.
# Set to "false" to bypass verification (useful for EC2/testing).
# -----------------------------------------------------------------------------
EMAIL_VERIFICATION_ENABLED=false

# -----------------------------------------------------------------------------
# Google OAuth [OPTIONAL — required only if Google login is enabled]
# Create credentials at https://console.cloud.google.com
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Companies House API [OPTIONAL — required only for UK company KYC lookup]
# Get your key at https://developer.company-information.service.gov.uk
# If not set, a mock company response is returned (safe for development).
# -----------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key

# -----------------------------------------------------------------------------
# Server Port [OPTIONAL]
# Defaults to 3000 if not set.
# -----------------------------------------------------------------------------
PORT=3000
