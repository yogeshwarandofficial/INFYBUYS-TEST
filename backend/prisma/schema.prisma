generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String?
  roles             Role[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  verifiedAt        DateTime?
  settings          Json?
  adminActionLogs   AdminActionLog[]   @relation("AdminActionLogs")
  buyerProfile      BuyerProfile?
  buyerEnquiries    Enquiry[]          @relation("BuyerEnquiries")
  sellerEnquiries   Enquiry[]          @relation("SellerEnquiries")
  enquiryMessages   EnquiryMessage[]   @relation("UserEnquiryMessages")
  favorites         Favorite[]         @relation("UserFavorites")
  listings          Listing[]
  listingRevisions  ListingRevision[]
  ndaAcceptances    NdaAgreement[]
  payments          Payment[]
  refreshTokens     RefreshToken[]
  otpVerifications  OtpVerification[]
  givenReviews      Review[]           @relation("GivenReviews")
  receivedReviews   Review[]           @relation("ReceivedReviews")
  savedSearches     SavedSearch[]      @relation("BuyerSavedSearches")
  sellerProfile     SellerProfile?
  userSubscriptions UserSubscription[]
}

model BuyerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  avatarKey String?
  company   String?
  jobTitle  String?
  location  String?
  bio       String?
  buyerType String?
  website   String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  businessName        String
  companyNumber       String?
  kycStatus           KycStatus           @default(PENDING)
  verifiedBadge       Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  businessAddress     String?
  kycRejectionReason  String?
  kycReviewedAt       DateTime?
  kycReviewedBy       String?
  kycSubmittedAt      DateTime?
  legalName           String?
  phone               String?
  avatarKey           String?
  bio                 String?
  jobTitle            String?
  linkedin            String?
  location            String?
  preferredCategories String[]
  preferredLocations  String[]
  sellerType          String?
  website             String?
  yearsOfExperience   String?
  kycDocuments        SellerKycDocument[]
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id                  String            @id @default(uuid())
  sellerId            String
  type                ListingType
  category            String
  title               String
  description         String
  priceOrRent         Decimal           @db.Decimal(12, 2)
  currency            String            @default("GBP")
  locationArea        String
  locationPostcode    String
  locationExact       String?
  turnover            Decimal?          @db.Decimal(12, 2)
  netProfit           Decimal?          @db.Decimal(12, 2)
  establishedYear     Int?
  status              ListingStatus     @default(DRAFT)
  rejectionReasonCode String?
  ndaRequired         Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  expiresAt           DateTime?
  contactEmail        String?
  contactName         String?
  contactPhone        String?
  coverMediaId        String?
  enquiries           Enquiry[]
  favorites           Favorite[]        @relation("ListingFavorites")
  seller              User              @relation(fields: [sellerId], references: [id])
  media               ListingMedia[]
  revisions           ListingRevision[]
  views               ListingView[]
  ndaAcceptances      NdaAgreement[]
  reviews             Review[]

  @@index([sellerId])
  @@index([status, type, locationArea])
}

model ListingMedia {
  id                String           @id @default(uuid())
  listingId         String
  url               String?
  type              MediaType
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  s3Key             String?
  listingRevisionId String?
  listing           Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingRevision   ListingRevision? @relation(fields: [listingRevisionId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model SubscriptionPlan {
  id                String               @id @default(uuid())
  audience          SubscriptionAudience
  name              String
  price             Decimal              @db.Decimal(12, 2)
  billingCycle      BillingCycle
  featureLimits     Json
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id          String             @id @default(uuid())
  userId      String
  planId      String
  status      SubscriptionStatus
  startDate   DateTime           @default(now())
  renewalDate DateTime?
  paymentRef  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  user        User               @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("GBP")
  status        String
  gatewayRef    String
  invoicePdfUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([gatewayRef])
}

model Enquiry {
  id            String           @id @default(uuid())
  listingId     String
  buyerId       String
  sellerId      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())
  status        EnquiryStatus    @default(PENDING)
  buyer         User             @relation("BuyerEnquiries", fields: [buyerId], references: [id])
  listing       Listing          @relation(fields: [listingId], references: [id])
  seller        User             @relation("SellerEnquiries", fields: [sellerId], references: [id])
  messages      EnquiryMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model EnquiryMessage {
  id          String    @id @default(uuid())
  enquiryId   String
  senderId    String
  messageText String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  enquiry     Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  sender      User      @relation("UserEnquiryMessages", fields: [senderId], references: [id])

  @@index([enquiryId])
  @@index([senderId])
}

model SavedSearch {
  id             String       @id @default(uuid())
  buyerId        String
  filtersJson    Json?
  alertFrequency String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  category       String?
  listingType    ListingType?
  location       String?
  maxPrice       Decimal?     @db.Decimal(12, 2)
  minPrice       Decimal?     @db.Decimal(12, 2)
  name           String       @default("Saved Search")
  search         String?
  buyer          User         @relation("BuyerSavedSearches", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

model Review {
  id        String   @id @default(uuid())
  listingId String?
  sellerId  String?
  buyerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buyer     User     @relation("GivenReviews", fields: [buyerId], references: [id])
  listing   Listing? @relation(fields: [listingId], references: [id])
  seller    User?    @relation("ReceivedReviews", fields: [sellerId], references: [id])
}

model AdminActionLog {
  id           String   @id @default(uuid())
  adminId      String
  actionType   String
  targetEntity String
  reason       String?
  timestamp    DateTime @default(now())
  admin        User     @relation("AdminActionLogs", fields: [adminId], references: [id])
}

model NdaAgreement {
  id          String    @id @default(uuid())
  listingId   String
  buyerId     String
  status      NdaStatus @default(REQUESTED)
  ndaVersion  String    @default("1.0")
  requestedAt DateTime  @default(now())
  signedAt    DateTime?
  buyer       User      @relation(fields: [buyerId], references: [id])
  listing     Listing   @relation(fields: [listingId], references: [id])

  @@unique([listingId, buyerId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model OtpVerification {
  id        String    @id @default(uuid())
  userId    String
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
}

model ListingRevision {
  id              String         @id @default(uuid())
  listingId       String
  createdBy       String
  status          RevisionStatus @default(PENDING)
  proposedData    Json
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  media           ListingMedia[]
  user            User           @relation(fields: [createdBy], references: [id])
  listing         Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
}

model SellerKycDocument {
  id               String          @id @default(uuid())
  sellerProfileId  String
  documentType     KycDocumentType
  s3Key            String
  originalFileName String
  mimeType         String
  uploadedAt       DateTime        @default(now())
  verifiedAt       DateTime?
  verifiedBy       String?
  sellerProfile    SellerProfile   @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
}

model Favorite {
  id        String   @id @default(uuid())
  buyerId   String
  listingId String
  createdAt DateTime @default(now())
  buyer     User     @relation("UserFavorites", fields: [buyerId], references: [id], onDelete: Cascade)
  listing   Listing  @relation("ListingFavorites", fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([buyerId, listingId])
  @@index([buyerId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ListingView {
  id        String   @id @default(uuid())
  listingId String
  viewerId  String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([createdAt])
}

enum EnquiryStatus {
  PENDING
  SELLER_RESPONDED
  IN_DISCUSSION
  NDA_REQUESTED
  NDA_SIGNED
  CLOSED
  REJECTED
}

enum NdaStatus {
  REQUESTED
  SIGNED
}

enum Role {
  BUYER
  SELLER
  AGENCY
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  REJECTED
  PUBLISHED
  PAUSED
  SOLD_LET
  EXPIRED
  CHANGES_PENDING_REVIEW
  REJECTED_CHANGES
}

enum RevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionAudience {
  BUYER
  SELLER
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum KycDocumentType {
  IDENTITY
  BUSINESS_PROOF
  ADDRESS_PROOF
  OTHER
}

enum NotificationType {
  NEW_ENQUIRY
  NEW_MESSAGE
  KYC_APPROVED
  KYC_REJECTED
  LISTING_APPROVED
  LISTING_REJECTED
  NDA_REQUESTED
  NDA_SIGNED
  SAVED_SEARCH_MATCH
}
