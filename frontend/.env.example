# =============================================================================
# INFYBUYS — Frontend Environment Variables
# Copy to .env and fill in values. Vite proxies /api/* to the backend in dev,
# so VITE_API_BASE_URL is not needed for local development.
# =============================================================================

# Backend API base URL — only needed if NOT using the Vite dev proxy.
# In production this should be your backend's public URL.
# VITE_API_BASE_URL=https://api.infybuys.com

# Google OAuth Client ID — must match the GOOGLE_CLIENT_ID on the backend.
# Get from: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# NOTE: VITE_EMAIL_VERIFICATION_ENABLED has been removed.
# The backend (EMAIL_VERIFICATION_ENABLED env var) is the single source of truth.
# Set EMAIL_VERIFICATION_ENABLED=true in backend/.env to enforce OTP verification.
